# Modèle de ~/.config/claude-sandbox-infra/supervision.env (ADR-007) — à copier HORS du dépôt,
# puis : chmod 600 ~/.config/claude-sandbox-infra/supervision.env
# Aucune valeur réelle ici. Les URL : https://hôte[:port], sans chemin ni barre finale.
# Outil non utilisé : URL http://127.0.0.1:9 et jeton vide (le relais renverra une erreur 502).

# Grafana — jeton d'un compte de service en rôle Viewer (le certificat client et sa clé vont
# dans ~/.config/claude-sandbox-infra/supervision/grafana-client.crt et .key, mode 600).
GRAFANA_URL=https://grafana.exemple.invalid
GRAFANA_TOKEN=

# Alertmanager — sans authentification côté outil : laisser vide. Si un jour l'outil en exige
# une, valeur complète de l'en-tête (ex. « Basic … »).
ALERTMANAGER_URL=http://alertmanager.exemple.invalid:9093
ALERTMANAGER_AUTHORIZATION=

# GoAlert — clé API GraphQL dédiée, politique limitée aux champs de lecture, rôle User.
GOALERT_URL=https://goalert.exemple.invalid
GOALERT_TOKEN=

# Semaphore — jeton d'API de l'utilisateur dédié (rôle Guest dans chaque projet à lire).
SEMAPHORE_URL=https://semaphore.exemple.invalid
SEMAPHORE_TOKEN=
